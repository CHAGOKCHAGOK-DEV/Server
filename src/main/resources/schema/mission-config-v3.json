{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chagokchagok.dev/schema/mission-config-v3.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "sourceIds",
    "trigger",
    "execution",
    "ageContent"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]{2}$"
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "enum": [
            "TURN_SIGNAL_OFF",
            "MISSION_COMPLETED",
            "WIPER_ON",
            "WIPER_OFF",
            "NAVI_NEXT_TURN",
            "SPEED_STABLE",
            "VEHICLE_STOPPED",
            "TRIP_STARTED",
            "TURN_SIGNAL_SUMMARY",
            "SPEED_CHANGED",
            "NEAR_DESTINATION",
            "TRIP_ENDED"
          ]
        },
        "minOnMs": {
          "type": "integer",
          "minimum": 1
        },
        "directionRequired": {
          "type": "boolean"
        },
        "minDistanceMeters": {
          "type": "integer",
          "minimum": 0
        },
        "maxDistanceMeters": {
          "type": "integer",
          "minimum": 1
        },
        "minSpeedKph": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMissionCode": {
          "type": "string",
          "minLength": 1
        },
        "maxPerDay": {
          "type": "integer",
          "minimum": 1
        },
        "intervalMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "noEventMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "straightRoadRequired": {
          "type": "boolean"
        },
        "onDemandPhrase": {
          "type": "string",
          "minLength": 1
        },
        "recognitionFailureCount": {
          "type": "integer",
          "minimum": 1
        },
        "pauseCommand": {
          "type": "string",
          "minLength": 1
        },
        "stableSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "toleranceKph": {
          "type": "integer",
          "minimum": 0
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "stoppedSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "minSignalCount": {
          "type": "integer",
          "minimum": 0
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "deltaKphExclusive": {
          "type": "integer",
          "minimum": 0
        },
        "etaSecondsAtMost": {
          "type": "integer",
          "minimum": 0
        },
        "skipTies": {
          "type": "boolean"
        },
        "endGear": {
          "const": "P"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validity",
        "cooldownSecondsByIntensity",
        "holdWhen"
      ],
      "properties": {
        "validity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "durationMs"
              ],
              "properties": {
                "mode": {
                  "const": "TIME"
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "expireAtDistanceMeters"
              ],
              "properties": {
                "mode": {
                  "const": "NAVIGATION_DISTANCE"
                },
                "expireAtDistanceMeters": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "ROUTE_ACTIVE"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "STOPPED"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "UNTIL_RESTART"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "TRIP_END"
                }
              }
            }
          ]
        },
        "cooldownSecondsByIntensity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "LOW",
            "NORMAL",
            "HIGH"
          ],
          "properties": {
            "LOW": {
              "type": "integer",
              "minimum": 0
            },
            "NORMAL": {
              "type": "integer",
              "minimum": 0
            },
            "HIGH": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "maxPerTrip": {
          "type": "integer",
          "minimum": 1
        },
        "holdWhen": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turnSignalOn",
            "naviSpeaking"
          ],
          "properties": {
            "turnSignalOn": {
              "type": "boolean"
            },
            "naviSpeaking": {
              "type": "boolean"
            },
            "nextTurnWithinMeters": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "askWhen": {
          "enum": [
            "DRIVING",
            "STOPPED",
            "TRIP_END"
          ]
        },
        "noAnswerCompletes": {
          "type": "boolean"
        },
        "presentationOnly": {
          "type": "boolean"
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event",
            "thresholdSeconds",
            "discardAfterSeconds",
            "discardOnParking"
          ],
          "properties": {
            "event": {
              "const": "VEHICLE_RESTARTED"
            },
            "thresholdSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "discardAfterSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "discardOnParking": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "ageContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AGE_5_6",
        "AGE_7_8",
        "AGE_9_PLUS"
      ],
      "properties": {
        "AGE_5_6": {
          "$ref": "#/$defs/content"
        },
        "AGE_7_8": {
          "$ref": "#/$defs/content"
        },
        "AGE_9_PLUS": {
          "$ref": "#/$defs/content"
        }
      }
    }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "answerKind",
        "expectedAnswer",
        "correctMessage",
        "wrongMessage"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "answerKind": {
          "enum": [
            "YES_NO",
            "LEFT_RIGHT",
            "FREE",
            "NONE",
            "BACKCAR_SKY",
            "BEFORE_AFTER",
            "WIPER_LIGHT",
            "STOPPED_POURING",
            "FAST_SLOW",
            "STOP_GO",
            "GREEN_RED",
            "SOON_LONG"
          ]
        },
        "expectedAnswer": {
          "type": "string",
          "minLength": 1
        },
        "correctMessage": {
          "type": "string",
          "maxLength": 300
        },
        "wrongMessage": {
          "type": "string",
          "maxLength": 300
        },
        "thresholdKph": {
          "type": "integer",
          "minimum": 0
        },
        "comparisonSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
